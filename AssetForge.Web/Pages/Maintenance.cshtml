@page
@model MaintenanceModel
@{ViewData["Title"]="Maintenance";}<header class="page-head"><div><div class="eyebrow">SERVICE DESK</div><h1>Maintenance</h1><p>Track repairs, suppliers, costs and outcomes.</p></div></header><section class="card"><form method="post" class="maintenance-form"><label>Asset<select asp-for="Input.AssetId" asp-items="Model.Assets"></select></label><label>Issue<input asp-for="Input.Issue" required/></label><label>Supplier<input asp-for="Input.Supplier"/></label><button class="primary">OPEN REPAIR</button></form></section><section class="table maintenance-table"><div class="tr head"><span>ASSET</span><span>ISSUE</span><span>SUPPLIER</span><span>STATUS / ACTION</span></div>@foreach(var r in Model.Records){<div class="tr"><span><b>@r.Asset?.AssetTag</b><small>@r.Asset?.Name</small></span><span>@r.Issue<small>@r.OpenedUtc.ToLocalTime().ToString("dd MMM yyyy")</small></span><span>@r.Supplier<small>@(r.Cost.HasValue?$"£{r.Cost:0.00}":"")</small></span><span>@if(r.Status=="Open"){<form method="post" asp-page-handler="Complete" class="complete-form"><input type="hidden" name="id" value="@r.Id"/><input name="resolution" placeholder="Resolution" required/><input name="cost" type="number" step=".01" placeholder="Cost"/><button class="primary">COMPLETE</button></form>}else{<b>@r.Status</b><small>@r.Resolution</small>}</span></div>}</section>
