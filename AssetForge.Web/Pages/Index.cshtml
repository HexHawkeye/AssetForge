@page
@model IndexModel
@{ViewData["Title"]="Overview";}<header class="page-head"><div><div class="eyebrow">ASSET INTELLIGENCE</div><h1>Everything accounted for.</h1><p>A clear view of equipment, ownership and condition.</p></div><a class="primary button" href="/Assets/Edit">+ ADD ASSET</a></header><section class="stats"><article><small>TOTAL ASSETS</small><strong>@Model.Total</strong><span>registered equipment</span></article><article><small>AVAILABLE</small><strong class="mint">@Model.Available</strong><span>ready to assign</span></article><article><small>ASSIGNED</small><strong>@Model.Assigned</strong><span>currently in use</span></article><article><small>NEEDS ATTENTION</small><strong class="orange">@Model.Attention</strong><span>repair or lost</span></article></section><div class="section-title"><h2>Recently added</h2><a href="/Assets">VIEW ALL →</a></div><section class="table"><div class="tr head"><span>ASSET</span><span>CATEGORY</span><span>LOCATION</span><span>STATUS</span></div>@foreach(var a in Model.Recent){<a class="tr" href="/Assets/Edit?id=@a.Id"><span><b>@a.AssetTag</b><small>@a.Name</small></span><span>@a.Category?.Name</span><span>@(a.Location?.Name??"—")</span><span><i class="status @a.Status.ToLower()"></i>@a.Status</span></a>}</section>
