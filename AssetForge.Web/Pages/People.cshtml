@page
@model PeopleModel
@{ViewData["Title"]="People";}<header class="page-head"><div><div class="eyebrow">CUSTODIANS</div><h1>People</h1><p>Employees and other equipment holders.</p></div></header><section class="card"><form method="post" class="person-form"><label>Full name<input asp-for="Input.FullName" required/></label><label>Email<input asp-for="Input.Email" type="email"/></label><label>Employee number<input asp-for="Input.EmployeeNumber"/></label><label>Department<select asp-for="Input.DepartmentId" asp-items="Model.Departments"><option value="">None</option></select></label><button class="primary">ADD PERSON</button></form></section><section class="table people-table"><div class="tr head"><span>PERSON</span><span>EMPLOYEE</span><span>DEPARTMENT</span><span>STATUS</span></div>@foreach(var p in Model.People){<div class="tr"><span><b>@p.FullName</b><small>@p.Email</small></span><span>@p.EmployeeNumber</span><span>@p.Department?.Name</span><span>@(p.Active?"Active":"Inactive")</span></div>}</section>
