@page "/Lookup/{tag}"
@model LookupModel
@{ViewData["Title"]="Asset lookup";}<div class="scan-page">@if(Model.Asset is null){<section class="card"><h1>Asset not found</h1><p>This code does not match an AssetForge record.</p></section>}else{<section class="card"><div class="eyebrow">VERIFIED ASSET</div><h1>@Model.Asset.AssetTag</h1><h2>@Model.Asset.Name</h2><dl><dt>Category</dt><dd>@Model.Asset.Category?.Name</dd><dt>Status</dt><dd><i class="status @Model.Asset.Status.ToLower()"></i>@Model.Asset.Status</dd><dt>Location</dt><dd>@(Model.Asset.Location?.Name??"Not recorded")</dd></dl><p class="safe-note">Public lookup deliberately hides serial numbers, prices, notes and holder information.</p>@if(User.Identity?.IsAuthenticated==true){<a class="primary button" href="/Custody">MANAGE CUSTODY</a>}</section>}</div>
