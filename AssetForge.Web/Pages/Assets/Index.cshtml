@page
@model AssetForge.Web.Pages.Assets.IndexModel
@{ViewData["Title"]="Assets";}<header class="page-head"><div><div class="eyebrow">INVENTORY</div><h1>Assets</h1><p>Search, filter and manage every registered item.</p></div><a class="primary button" href="/Assets/Edit">+ ADD ASSET</a></header><form class="filters"><input name="search" value="@Model.Search" placeholder="Search tag, name or serial…"/><select name="status"><option value="">All statuses</option>@foreach(var s in new[]{"Available","Assigned","Repair","Lost","Retired"}){<option value="@s" selected="@(Model.Status==s)">@s</option>}</select><button class="primary">FILTER</button></form><section class="table assets"><div class="tr head"><span>TAG / NAME</span><span>DETAILS</span><span>LOCATION</span><span>DEPARTMENT</span><span>STATUS</span></div>@foreach(var a in Model.Assets){<a class="tr" href="/Assets/Edit?id=@a.Id"><span><b>@a.AssetTag</b><small>@a.Name</small></span><span>@a.Manufacturer @a.Model<small>@a.SerialNumber</small></span><span>@(a.Location?.Name??"—")</span><span>@(a.Department?.Name??"—")</span><span><i class="status @a.Status.ToLower()"></i>@a.Status</span></a>}</section>
