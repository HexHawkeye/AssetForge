@page
@model AssetForge.Web.Pages.Assets.EditModel
@{ViewData["Title"]=Model.Input.Id==0?"Add asset":"Edit asset";}<header class="page-head"><div><div class="eyebrow">ASSET RECORD</div><h1>@ViewData["Title"]</h1><p>@(Model.Input.Id==0?"Register equipment in AssetForge.":$"{Model.Input.AssetTag} · {Model.Input.Name}")</p></div></header><section class="card"><form method="post" class="edit-form"><input type="hidden" asp-for="Input.Id"/><label>Name<input asp-for="Input.Name" required/></label><label>Category<select asp-for="Input.CategoryId" asp-items="Model.Categories"></select></label><label>Manufacturer<input asp-for="Input.Manufacturer"/></label><label>Model<input asp-for="Input.Model"/></label><label>Serial number<input asp-for="Input.SerialNumber"/></label><label>Status<select asp-for="Input.Status"><option>Available</option><option>Assigned</option><option>Repair</option><option>Lost</option><option>Retired</option></select></label><label>Location<select asp-for="Input.LocationId" asp-items="Model.Locations"><option value="">Unassigned</option></select></label><label>Department<select asp-for="Input.DepartmentId" asp-items="Model.Departments"><option value="">Unassigned</option></select></label><label>Purchase price<input asp-for="Input.PurchasePrice" type="number" step="0.01"/></label><label>Purchase date<input asp-for="Input.PurchaseDate" type="date"/></label><label>Warranty expires<input asp-for="Input.WarrantyExpires" type="date"/></label><label class="wide">Notes<textarea asp-for="Input.Notes" rows="4"></textarea></label><div class="actions"><button class="primary">SAVE ASSET</button><a href="/Assets">CANCEL</a></div></form></section>
