@page
@model CustodyModel
@{ViewData["Title"]="Custody";}<header class="page-head"><div><div class="eyebrow">ASSIGNMENTS</div><h1>Asset custody</h1><p>Issue equipment, record returns and retain the full history.</p></div></header>@if(TempData["Error"] is string e){<div class="error">@e</div>}<section class="card"><h2>Assign an asset</h2><form method="post" asp-page-handler="Assign" class="assign-form"><label>Asset<select asp-for="Input.AssetId" asp-items="Model.Assets"></select></label><label>Person<select asp-for="Input.PersonId" asp-items="Model.People"></select></label><label>Expected return<input asp-for="Input.ExpectedReturnUtc" type="date"/></label><label>Condition<select asp-for="Input.IssueCondition"><option>New</option><option>Good</option><option>Fair</option></select></label><label>Handover reference<input asp-for="Input.HandoverReference" placeholder="HO-2026-001"/></label><label>Notes<input asp-for="Input.IssueNotes"/></label><button class="primary">ASSIGN</button></form></section><h2>Currently assigned</h2><section class="table custody-table"><div class="tr head"><span>ASSET</span><span>PERSON</span><span>ASSIGNED</span><span>DUE</span><span>RETURN</span></div>@foreach(var a in Model.Active){var overdue=a.ExpectedReturnUtc<DateTime.UtcNow;<div class="tr"><span><b>@a.Asset?.AssetTag</b><small>@a.Asset?.Name</small></span><span>@a.Person?.FullName</span><span>@a.AssignedUtc.ToLocalTime().ToString("dd MMM yyyy")</span><span class="@(overdue?"orange":"")">@(a.ExpectedReturnUtc?.ToLocalTime().ToString("dd MMM yyyy")??"—")</span><form method="post" asp-page-handler="Return" class="return-form"><input type="hidden" name="id" value="@a.Id"/><select name="returnCondition"><option>Good</option><option>Fair</option><option>Damaged</option></select><input name="returnNotes" placeholder="Return notes"/><button class="primary">RETURN</button></form></div>}</section><h2>Custody history</h2><section class="table"><div class="tr head"><span>ASSET</span><span>PERSON</span><span>ISSUED</span><span>RETURNED</span></div>@foreach(var a in Model.History){<div class="tr"><span>@a.Asset?.AssetTag</span><span>@a.Person?.FullName</span><span>@a.AssignedUtc.ToLocalTime().ToString("dd MMM yyyy")</span><span>@(a.ReturnedUtc?.ToLocalTime().ToString("dd MMM yyyy")??"Active")</span></div>}</section>
